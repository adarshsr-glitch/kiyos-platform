# Copy to .env and fill in. Never commit .env.

# --- Anthropic ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Models (defaults set in code; override here if needed) ---
MODEL_REASONING=claude-opus-5-5
MODEL_EXTRACTION=claude-haiku-5-5

# --- Data layer ---
# SQLite on disk. Nuke the file to reset. ./data/ is gitignored.
DATABASE_URL=sqlite+aiosqlite:///./data/kiyos.db
DOCUMENTS_DIR=./data/documents

# --- App ---
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
