# Copy to .env and fill in. Never commit .env.

# --- Supabase ---
# Find these in your Supabase project settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<public anon key, safe for web>
SUPABASE_SERVICE_ROLE_KEY=<secret, api-only, never ships to web>
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Anthropic ---
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Models (defaults set in code; override here if needed) ---
MODEL_REASONING=claude-opus-5-5
MODEL_EXTRACTION=claude-haiku-5-5

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_HOST=0.0.0.0
API_PORT=8000
